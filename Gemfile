source "https://rubygems.org"

# Use the github-pages gem to match the exact Jekyll version
# and plugin set that GitHub Pages uses in production.
# https://github.com/github/pages-gem
gem "github-pages", group: :jekyll_plugins

# Jekyll plugins (included in github-pages gem, listed for clarity)
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Performance
gem "wdm", "~> 0.1.1" if Gem.win_platform?
